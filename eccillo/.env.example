# --- Database ---
DB_NAME=eccillo
DB_USER=eccillo
DB_PASSWORD=eccillo
DB_HOST=localhost
DB_PORT=5432

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Payments (Phase 2+) ---
STRIPE_SECRET_KEY=
ESEWA_MERCHANT_ID=
KHALTI_SECRET_KEY=

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api/v1

# --- Outbound mail (procurement outreach) ---
# Leave EMAIL_HOST empty to print outreach to the console instead of sending it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Eccillo <no-reply@eccillo.dev>
# Origin of the web app — used to build the vendor reply link in outreach mail.
PUBLIC_WEB_URL=http://localhost:5173

# --- Agent layer (Phase 2 AI orchestration) ---
# Provider: openai | anthropic | gemini | ollama (or any OpenAI-compatible server
# via OPENAI_BASE_URL). Set AGENT_LLM_MODEL to override the per-provider default.
AGENT_LLM_PROVIDER=openai
AGENT_LLM_MODEL=

# OpenAI (and OpenAI-compatible servers: vLLM, LM Studio, OpenRouter, Groq…)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini (either var works)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama — local, no key required. Use 127.0.0.1 (IPv4), NOT localhost:
# on Windows "localhost" resolves to IPv6 ::1 and may hit a different daemon.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Orchestration tuning
AGENT_LLM_TEMPERATURE=0.2
AGENT_MAX_CONCURRENCY=4
AGENT_MAX_SKILL_RETRIES=2
AGENT_CONVERSATION_WINDOW=12

# Agent turn execution. Dev defaults to eager (turns run inline in runserver, no
# Celery worker needed). Set to false to use the async worker (make worker).
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
